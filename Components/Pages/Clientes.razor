@page "/clientes"
@inject IDbContextFactory<AutoGestionContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Clientes - AutoGestión</PageTitle>

<div class="ag-container ag-section">
    <div class="ag-page-head">
        <div>
            <h1>Clientes</h1>
            <p class="text-secondary mb-0">Registra y administra a los clientes del taller.</p>
        </div>
        @if (!mostrandoFormulario)
        {
            <button class="ag-btn" @onclick="Nuevo">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo cliente
            </button>
        }
    </div>

    @if (mensaje is not null)
    {
        <div class="alert @(mensajeEsError ? "alert-danger" : "alert-success") d-flex justify-content-between align-items-center" role="status">
            <span>@mensaje</span>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => mensaje = null"></button>
        </div>
    }

    @if (mostrandoFormulario)
    {
        <section class="ag-panel">
            <h2 class="h4 mb-3">@(cliente.Id == 0 ? "Nuevo cliente" : "Editar cliente")</h2>
            <EditForm Model="cliente" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="nombre">Nombre</label>
                        <InputText id="nombre" class="form-control" @bind-Value="cliente.Nombre" />
                        <ValidationMessage For="() => cliente.Nombre" class="text-danger small" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="telefono">Teléfono</label>
                        <InputText id="telefono" type="tel" class="form-control" @bind-Value="cliente.Telefono" />
                        <ValidationMessage For="() => cliente.Telefono" class="text-danger small" />
                    </div>
                    <div class="col-md-7">
                        <label class="form-label" for="domicilio">Domicilio <span class="text-secondary">(opcional)</span></label>
                        <InputText id="domicilio" class="form-control" @bind-Value="cliente.Domicilio" />
                        <ValidationMessage For="() => cliente.Domicilio" class="text-danger small" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="correo">Correo <span class="text-secondary">(opcional)</span></label>
                        <InputText id="correo" type="email" class="form-control"
                                   Value="cliente.Correo"
                                   ValueChanged="@((string? v) => cliente.Correo = string.IsNullOrWhiteSpace(v) ? null : v)"
                                   ValueExpression="() => cliente.Correo" />
                        <ValidationMessage For="() => cliente.Correo" class="text-danger small" />
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="ag-btn mt-0 border-0">Guardar cliente</button>
                    <button type="button" class="ag-btn-ghost" @onclick="Cancelar">Cancelar</button>
                </div>
            </EditForm>
        </section>
    }

    <div class="mb-3" style="max-width: 420px;">
        <label class="visually-hidden" for="buscar">Buscar cliente</label>
        <input id="buscar" class="form-control" placeholder="Buscar por nombre o teléfono"
               @bind="filtro" @bind:event="oninput" />
    </div>

    @if (cargando)
    {
        <p class="text-secondary">Cargando clientes…</p>
    }
    else if (!clientes.Any())
    {
        <section class="ag-panel text-center">
            <i class="bi bi-people ag-card-icon" aria-hidden="true"></i>
            <p class="mt-2 mb-0">Aún no hay clientes registrados. Usa «Nuevo cliente» para agregar el primero.</p>
        </section>
    }
    else if (!Filtrados.Any())
    {
        <p class="text-secondary">Ningún cliente coincide con «@filtro».</p>
    }
    else
    {
        <div class="ag-panel ag-panel-flush">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Domicilio</th>
                        <th>Correo</th>
                        <th class="text-center">Vehículos</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Filtrados)
                    {
                        <tr>
                            <td>@c.Nombre</td>
                            <td>@c.Telefono</td>
                            <td>@(string.IsNullOrWhiteSpace(c.Domicilio) ? "—" : c.Domicilio)</td>
                            <td>@(string.IsNullOrWhiteSpace(c.Correo) ? "—" : c.Correo)</td>
                            <td class="text-center">@c.Vehiculos.Count</td>
                            <td class="text-end text-nowrap">
                                <button class="ag-icon-btn" title="Editar" aria-label="Editar a @c.Nombre" @onclick="() => Editar(c)">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </button>
                                <button class="ag-icon-btn ag-danger" title="Eliminar" aria-label="Eliminar a @c.Nombre" @onclick="() => Eliminar(c)">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Cliente> clientes = new();
    private Cliente cliente = new();
    private bool cargando = true;
    private bool mostrandoFormulario;
    private string filtro = string.Empty;
    private string? mensaje;
    private bool mensajeEsError;

    private IEnumerable<Cliente> Filtrados =>
        string.IsNullOrWhiteSpace(filtro)
            ? clientes
            : clientes.Where(c => c.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase)
                               || c.Telefono.Contains(filtro));

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        clientes = await db.Clientes
            .Include(c => c.Vehiculos)
            .OrderBy(c => c.Nombre)
            .ToListAsync();
        cargando = false;
    }

    private void Nuevo()
    {
        cliente = new Cliente();
        mostrandoFormulario = true;
        mensaje = null;
    }

    private void Editar(Cliente c)
    {
        // Se edita una copia para no alterar la fila de la tabla si se cancela
        cliente = new Cliente
        {
            Id = c.Id,
            Nombre = c.Nombre,
            Telefono = c.Telefono,
            Domicilio = c.Domicilio,
            Correo = c.Correo
        };
        mostrandoFormulario = true;
        mensaje = null;
    }

    private void Cancelar() => mostrandoFormulario = false;

    private async Task Guardar()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        if (cliente.Id == 0)
            db.Clientes.Add(cliente);
        else
            db.Clientes.Update(cliente);

        await db.SaveChangesAsync();

        mostrandoFormulario = false;
        Mostrar("Cliente guardado.", false);
        await Cargar();
    }

    private async Task Eliminar(Cliente c)
    {
        if (c.Vehiculos.Count > 0)
        {
            Mostrar($"No se puede eliminar a {c.Nombre}: tiene {c.Vehiculos.Count} vehículo(s) registrado(s).", true);
            return;
        }

        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar a {c.Nombre}?"))
            return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.Clientes.Remove(new Cliente { Id = c.Id });
            await db.SaveChangesAsync();
            Mostrar("Cliente eliminado.", false);
        }
        catch (DbUpdateException)
        {
            Mostrar("No se pudo eliminar al cliente porque tiene información relacionada.", true);
        }

        await Cargar();
    }

    private void Mostrar(string texto, bool error)
    {
        mensaje = texto;
        mensajeEsError = error;
    }
}
